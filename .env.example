# Resend (https://resend.com) — usado para enviar las aplicaciones del formulario por correo.
# 1. Crea una cuenta gratuita en resend.com con el correo donde quieres recibir las aplicaciones.
# 2. Genera un API Key en resend.com/api-keys y pégalo aquí.
RESEND_API_KEY=

# Correo donde quieres recibir cada aplicación enviada desde /aplicar.
# Sin verificar un dominio propio en Resend, solo puedes recibir en el correo con el que te registraste.
APPLICATION_TO_EMAIL=omartrendylike@gmail.com

# Opcional: remitente del correo. Requiere un dominio verificado en Resend.
# Si lo dejas vacío, se usa el remitente de pruebas de Resend (onboarding@resend.dev).
RESEND_FROM_EMAIL=
